{
    "name": "@pixel-guess/mobile",
    "version": "1.6.0",
    "main": "expo-router/entry",
    "scripts": {
        "dev": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "lint": "eslint .",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@pixel-guess/shared": "workspace:*",
        "@shopify/react-native-skia": "2.14.0",
        "expo": "^58.0.0",
        "expo-constants": "~58.0.16",
        "expo-image": "~58.0.18",
        "expo-linking": "~58.0.17",
        "expo-router": "~58.0.32",
        "expo-splash-screen": "~58.0.14",
        "expo-status-bar": "~58.0.5",
        "expo-system-ui": "~58.0.7",
        "expo-tracking-transparency": "~58.1.0",
        "lucide-react-native": "^1.76.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.1",
        "react-native-confetti-cannon": "^1.5.2",
        "react-native-google-mobile-ads": "^17.4.0",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.11.1",
        "react-native-screens": "~4.30.1",
        "react-native-svg": "15.16.1",
        "react-native-web": "^0.21.2",
        "react-native-worklets": "0.13.1",
        "tailwindcss": "^4.2.1",
        "uniwind": "^1.14.0"
    },
    "devDependencies": {
        "@types/react": "~19.3.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "babel-preset-expo": "~58.0.0",
        "eslint": "^10.15.0",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-perfectionist": "^5.14.0",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.73.0"
