{
  "expo": {
    "name": "Pixel Guess",
    "slug": "pixelate-game-mobile",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "pixelguess",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.haccoo.pixel-guess",
      "appleTeamId": "67M6SCS9K9",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "Pixel Guess uses your device's advertising identifier so the ads between rounds match the kinds of games you already play, and so the same ad is not repeated at you. Decline and you will still see ads, just untargeted ones."
      },
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.haccoo.pixel_guess",
      "permissions": ["com.google.android.gms.permission.AD_ID"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-5250650495212334~5174161665",
          "androidAppId": "ca-app-pub-5250650495212334~5174161665"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad8c6bb8-7005-4ce7-9ea1-67cfbe1028c0"
      }
    },
    "owner": "jubstaa"
  }
}
