{
    "name": "@pixel-guess/shared",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./styles/*": "./src/styles/*"
    },
    "scripts": {
        "generate": "bun run scripts/generate-characters.ts",
        "generate:fresh": "bun run scripts/generate-characters.ts --fresh",
        "sync:images": "bun run scripts/sync-images.ts",
        "type-check": "tsc --noEmit && tsc -p tsconfig.scripts.json",
        "lint": "eslint src scripts",
        "test": "bun test"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.1172.0",
        "@types/bun": "^1.4.4",
        "@typescript/native": "npm:typescript@^7.0.2",
        "p-queue": "^10.0.0",
        "p-retry": "^9.0.0",
        "sharp": "^0.35.5",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "zod": "^4.6.7"
    }
}
