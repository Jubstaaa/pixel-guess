{
    "name": "pixel-guess",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Jubstaaa/pixel-guess.git"
    },
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "generate": "turbo run generate --filter=@pixel-guess/shared",
        "dev": "turbo run dev",
        "dev:web": "turbo run dev --filter=@pixel-guess/web",
        "dev:mobile": "turbo run dev --filter=@pixel-guess/mobile",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "typecheck": "turbo run type-check",
        "test": "turbo run test",
        "audit": "bun audit --audit-level=high",
        "depcruise": "depcruise apps/web/src packages/shared/src packages/shared/scripts --ts-config apps/web/tsconfig.json && depcruise apps/mobile --ts-config apps/mobile/tsconfig.json",
        "jscpd": "jscpd",
        "knip": "knip"
    },
    "devDependencies": {
        "@jubstaa/config": "^2.1.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "dependency-cruiser": "^18.8.0",
        "eslint": "^10.15.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.0",
        "jscpd": "^5.4.3",
        "knip": "^6.46.1",
        "prettier": "^3.10.1",
        "turbo": "^2.11.13",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "packageManager": "bun@1.4.5"
}
