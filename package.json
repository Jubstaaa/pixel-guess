{
    "name": "pixel-guess",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "generate": "turbo run generate --filter=@pixel-guess/shared",
        "dev": "turbo run dev",
        "dev:web": "turbo run dev --filter=@pixel-guess/web",
        "dev:mobile": "turbo run dev --filter=@pixel-guess/mobile",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "type-check": "turbo run type-check",
        "audit": "bun audit --audit-level=high --ignore=GHSA-qr28-fpjm-wq7f --ignore=GHSA-5p2g-fcmc-qvqq --ignore=GHSA-w3rx-r6r6-pgpr --ignore=GHSA-6g55-p6wh-862q --ignore=GHSA-r28c-9q8g-f849 --ignore=GHSA-mrhx-c7xc-m3w5"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.57.0",
        "@typescript-eslint/parser": "^8.72.2",
        "concurrently": "^9.2.5",
        "eslint": "^10.0.3",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.5.3",
        "turbo": "^2.5.3",
        "typescript": "~5.8.3",
        "vite": "^8.3.8"
    },
    "packageManager": "bun@1.2.14",
    "overrides": {
        "@react-native/codegen": "0.83.2"
    }
}
