{
    "name": "pixel-guess",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "generate": "turbo run generate --filter=@pixel-guess/shared",
        "dev": "turbo run dev",
        "dev:web": "turbo run dev --filter=@pixel-guess/web",
        "dev:mobile": "turbo run dev --filter=@pixel-guess/mobile",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
        "type-check": "turbo run type-check",
        "audit": "bun audit --audit-level=high"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "concurrently": "^10.0.7",
        "eslint": "^10.14.0",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.10.1",
        "turbo": "^2.11.11",
        "typescript": "~5.8.3",
        "vite": "^8.3.8"
    },
    "packageManager": "bun@1.2.14"
}
